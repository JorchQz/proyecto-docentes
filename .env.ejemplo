# Plantilla de secretos locales. NO pongas valores reales aquí.
#
# Copia este archivo como  .env.local  y rellénalo ahí.
# Todo archivo .env* está en .gitignore salvo esta plantilla.

# ── Supabase ───────────────────────────────────────────────────────────────
# https://supabase.com/dashboard/account/tokens → Generate new token
SUPABASE_ACCESS_TOKEN=

# ── Mercado Pago ───────────────────────────────────────────────────────────
# https://www.mercadopago.com.mx/developers/panel → tu aplicación → Credenciales
# Producción: APP_USR-...   |   Pruebas: TEST-...
MP_ACCESS_TOKEN=
MP_ACCESS_TOKEN_TEST=

# Panel de MP → tu aplicación → Webhooks → clave secreta.
MP_WEBHOOK_SECRET=

# ── Correo de confirmación (opcional) ──────────────────────────────────────
# https://resend.com → API Keys. Requiere dominio verificado.
RESEND_API_KEY=
